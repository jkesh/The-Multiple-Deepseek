{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.0",
  "identifier": "com.jkesh.dsh.webclient",
  "build": { "frontendDist": "../frontend/dist", "devUrl": "http://localhost:1420" },
  "app": {
    "security": { "csp": null },
    "windows": [{ "label": "main", "title": "DeepSeek Harness", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600, "resizable": true, "center": true }]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "DeepSeek Harness desktop client",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
