{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Team",
  "version": "0.1.0",
  "identifier": "com.jkesh.dsh.team",
  "build": { "frontendDist": "../dist" },
  "app": {
    "security": { "csp": null },
    "windows": [{ "label": "main", "title": "DeepSeek Harness Team", "url": "index.html", "width": 1280, "height": 820, "minWidth": 860, "minHeight": 600, "resizable": true, "center": true }]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "DeepSeek Harness desktop client with team orchestration",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
